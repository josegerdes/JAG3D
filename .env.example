# Mongo (precisa ser um replica set single-node para transactions funcionarem — ver ARCHITECTURE.md)
DATABASE_URL=mongodb://root:changeme@localhost:27017/?authSource=admin
DB=jag3d

# Auth
JWT_SECRET=
APP_SECRET=

# Licenca (par de chaves EC P-256 para o capability token, formato PEM de linha unica com \n)
LICENSE_TOKEN_PRIVATE_KEY=
LICENSE_TOKEN_PUBLIC_KEY=
NEXT_PUBLIC_LICENSE_TOKEN_PUBLIC_KEY=

PORT=3000
SEED_ADMIN_EMAIL=admin@jag3d.com
SEED_ADMIN_PASSWORD=

# Armazenamento de malhas (volume Docker em producao)
MESH_STORAGE_DIR=./storage/meshes
