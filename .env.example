# Mongo (precisa ser um replica set single-node para transactions funcionarem — ver ARCHITECTURE.md)
DATABASE_URL=mongodb://root:changeme@localhost:27017/?authSource=admin
DB=jag3d

# Auth
JWT_SECRET=
APP_SECRET=

# Licenca (par de chaves EC P-256 para o capability token). Aceita PEM cru (com quebra de linha
# real ou \n literal) OU o PEM inteiro codificado em base64 numa linha so — recomendado pra colar
# num painel de deploy que pode perder quebras de linha (ver src/lib/pem.ts). A chave publica e
# servida ao navegador em runtime via /api/license/public-key — nao precisa de NEXT_PUBLIC_*.
LICENSE_TOKEN_PRIVATE_KEY=
LICENSE_TOKEN_PUBLIC_KEY=

PORT=3000
SEED_ADMIN_EMAIL=admin@jag3d.com
SEED_ADMIN_PASSWORD=

# Armazenamento de malhas (volume Docker em producao)
MESH_STORAGE_DIR=./storage/meshes
